# Council — environment template. Copy to .env and fill in real values.

# --- LLM (OpenAI-compatible; works with OpenAI, Azure, OpenRouter, Ollama, etc.) ---
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
COUNCIL_MODEL_PLANNER=gpt-4o
COUNCIL_MODEL_DESIGNER=gpt-4o
COUNCIL_MODEL_IMPLEMENTER=gpt-4o

# --- Orchestrator ---
# Where the Axum server binds. The UI's Vite dev server proxies /api and /ws here.
COUNCIL_BIND=0.0.0.0:8080

# --- Redis ---
COUNCIL_REDIS_URL=redis://127.0.0.1:6379

# --- Logging ---
RUST_LOG=info,council_core=debug,council_orchestrator=debug,council_agent=debug
